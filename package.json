{
  "name": "shorts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Automated vertical 3D animated story shorts, rendered on GitHub Actions with Remotion + three.js",
  "scripts": {
    "skill": "bash scripts/fetch-skill.sh",
